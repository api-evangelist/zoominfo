{
  "opencollection": "1.0.0",
  "info": {
    "name": "ZoomInfo Authentication Usage API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zoominfo Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.zoominfo.com/lookup/usage"
          },
          "docs": "Retrieve current usage status using this endpoint."
        }
      ]
    }
  ],
  "bundled": true
}