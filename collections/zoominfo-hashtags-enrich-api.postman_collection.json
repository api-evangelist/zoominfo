    {
      "id": "f0bf8a12-bca9-4371-b6ec-5fbf823402b9",
      "name": "Hashtags Enrich",
      "description": {
        "content": "Use [Hashtags Enrich](#886fb5cc-b587-4f26-bd68-892798d45ffe) to retrieve company hashtags using valid query parameters. A Hashtags Enrich request requires you to specify the input parameters about the company you are enriching.\n\nRefer to the examples provided to build a valid JSON request. Use the [Hashtags Enrich Inputs](#a7bea20a-f496-431b-9403-337231c4a22e) endpoint to retrieve a list of valid input parameters you can provide.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d5f49d80-c6f1-4c5f-931f-6df7010f4092",
          "name": "Zoominfo Hashtags Enrich",
          "request": {
            "name": "Zoominfo Hashtags Enrich",
            "description": {
              "content": "Use this endpoint to match hashtag information based on [input values](#a7bea20a-f496-431b-9403-337231c4a22e) and return output fields in the response.\n\n**Input params**\n\n| Parameter | DataType | Description |\n| --- | --- | --- |\n| companyId | String | Required. The ID of the company for which you want to find hashtags. |\n\n**Output fields**\n\n| Field | Description |\n| --- | --- |\n| tag | Hashtag |\n| searchString | Hashtag string |\n| displayLabel | Hashtag string for display |\n| description | Hashtag description |\n| group | Hashtag group |\n| parentCategory | Hashtag parent category |\n| displayScore | Display hashtag score (yes or no) |\n| scoreUnit | Hashtag score unit |\n| hidden | Show or hide hashtag (Boolean) |\n| label | Hashtag label |\n| categorizedFlag | Categorized (Boolean) |",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "enrich",
                "hashtag"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json;charset=utf-8"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"<string>\"\n}",
              "options": {
