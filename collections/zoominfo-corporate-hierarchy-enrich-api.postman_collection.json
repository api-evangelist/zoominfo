                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json;charset=utf-8"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchCompanyInput\": [\n    {\n      \"companyName\": \"<string>\"\n    },\n    {\n      \"companyName\": \"<string>\"\n    }\n  ],\n  \"outputFields\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
